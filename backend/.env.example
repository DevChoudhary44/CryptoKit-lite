# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
PORT=3000
NODE_ENV=development

# Local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cryptokit

# Long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Public address of the site (used inside emailed links)
APP_URL=http://localhost:3000

# true = users must verify email before they can log in
REQUIRE_EMAIL_VERIFICATION=false

# Email (optional in development: if SMTP_HOST is empty, links are printed in the terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CryptoKit <no-reply@example.com>"

# Only needed if the frontend is opened from a DIFFERENT address (e.g. VS Code Live Server)
# CORS_ORIGIN=http://127.0.0.1:5500

# Folder that contains index.html. Default ".." (the repo root, one level above backend/).
# While testing from a separate backend folder, point it at your frontend folder, e.g.:
# FRONTEND_DIR=D:\Crypto-toolkit
# FRONTEND_DIR=..

# While testing from a separate folder: serve the NEW auth.js (backend/frontend-integration/auth.js)
# instead of the frontend's old one. Set to false (or remove) after the final merge.
# USE_AUTH_OVERRIDE=true
